# Embedding model is downloaded from Hugging Face on the first index build.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Any OpenAI-compatible chat endpoint.  Keep the real .env private.
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-chat-model
# Examples: https://api.openai.com/v1 or your approved compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
